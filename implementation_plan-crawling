### 3. Background Workers (Inngest)

#### [NEW] [crawl_functions.py](file:///c:/Users/ASUS/Desktop/python-next-boilerplate/backend/app/inngest_fns/crawl_functions.py)
Inngest background job untuk perayapan andal, toleran kegagalan, dan mematuhi politeness mode.
```python
import inngest
import asyncio
from uuid import UUID
from urllib.parse import urljoin, urlparse
from app.inngest_fns.client import inngest_client
from app.core.database import async_session_factory
from app.services.crawl_service import crawl_service
from app.core.crawl_models import CrawlJob, CrawledPage
from app.providers.html_extractor import HttpxHtmlExtractor
from sqlalchemy import select

@inngest_client.create_function(
    fn_id="execute-crawl-job",
    trigger=inngest.TriggerEvent(event="crawler/crawl.requested"),
    retries=1,
)
async def execute_crawl_job(ctx: inngest.Context, step: inngest.Step):
    job_id = UUID(ctx.event.data["job_id"])

    # 1. Fetch Job Config
    async def fetch_job():
        async with async_session_factory() as db:
            job = await crawl_service.get_job(db, job_id)
            return {
                "url": job.url,
                "max_depth": job.max_depth,
                "path_filter": job.path_filter,
                "limit_pages": job.limit_pages,
                "delay_seconds": job.delay_seconds
            }
            
    config = await step.run("fetch-config", fetch_job)

    # 2. Discover URLs (Sitemap + Root)
    async def discover_urls():
        urls = await crawl_service.discover_urls_from_sitemap(config["url"])
        if not urls:
            urls = [config["url"]]
        return urls[:config["limit_pages"]]

    discovered = await step.run("discover-initial-urls", discover_urls)

    async def update_discovered_count():
        async with async_session_factory() as db:
            job = await crawl_service.get_job(db, job_id)
            job.status = "PROCESSING"
            job.pages_discovered = len(discovered)
            await db.commit()
            
    await step.run("update-discovered", update_discovered_count)

    # 3. Scrape Queue
    crawled_count = 0
    extractor = HttpxHtmlExtractor()

    for target_url in discovered:
        # Check path filter
        if config["path_filter"]:
            if not re.search(config["path_filter"], target_url):
                continue

        async def crawl_page():
            try:
                html = await extractor.fetch_html(target_url)
                md_content = extractor.to_markdown(html)
                meta = extractor.extract_metadata(html, target_url)
                
                async with async_session_factory() as db:
                    page = CrawledPage(
                        crawl_job_id=job_id,
                        url=target_url,
                        title=meta.get("title", "No Title"),
                        markdown=md_content,
                        status_code=200
                    )
                    db.add(page)
                    
                    job = await crawl_service.get_job(db, job_id)
                    job.pages_crawled += 1
                    await db.commit()
                return True
            except Exception:
                return False

        success = await step.run(f"crawl-{target_url[:50]}", crawl_page)
        if success:
            crawled_count += 1

        if crawled_count >= config["limit_pages"]:
            break

        # Politeness Delay
        await asyncio.sleep(config["delay_seconds"])

    async def mark_completed():
        async with async_session_factory() as db:
            job = await crawl_service.get_job(db, job_id)
            job.status = "COMPLETED"
            job.completed_at = datetime.now()
            await db.commit()

    await step.run("mark-completed", mark_completed)
    return {"pages_crawled": crawled_count}
```

